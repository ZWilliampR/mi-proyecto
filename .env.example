# ============================================================
# FamilyIntegral API — Variables de Entorno
# Copia este archivo como .env y completa los valores
# cp .env.example .env
# ============================================================

# ----------------------------------------------------
# APLICACIÓN
# ----------------------------------------------------
APP_NAME=FamilyIntegralAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Cancun
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ----------------------------------------------------
# LOGS
# ----------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------
# BASE DE DATOS
# ----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=family_integral
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------------------
# SESIÓN Y CACHÉ
# ----------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------------------------------------
# CORREO
# ----------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@miapi.com"
MAIL_FROM_NAME="API Laravel"

# ----------------------------------------------------
# AWS (no utilizado actualmente)
# ----------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------
# GOOGLE CALENDAR API
# ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# ----------------------------------------------------
# NOTA DE CONFIGURACIÓN POR AMBIENTE
# ----------------------------------------------------

# Para Docker:
APP_URL=http://localhost:8000
DB_HOST=db
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# Para XAMPP:
APP_URL=http://localhost/family-integral-back/public
DB_HOST=127.0.0.1
GOOGLE_REDIRECT_URI=http://localhost/family-integral-back/public/api/google/callback

